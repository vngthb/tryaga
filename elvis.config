[
    {config, [
        #{files => ["src/*.erl"], ruleset => erl_files,
          %% Configuration errors use the library's existing thrown-map contract.
          rules => [{elvis_style, no_throw, #{ignore => [tryaga_configuration]}}]},
        #{files => ["test/*.erl"], ruleset => erl_files_test,
          %% This test deliberately throws from a user callback.
          rules => [{elvis_style, no_throw,
                     #{ignore => [{tryaga_tests, predicate_exceptions_propagate_test}]}}]}
    ]},
    {output_format, plain},
    {warnings_as_errors, true}
].
